# Defense in depth: never put secrets in this marketplace, public or private.
# API keys belong in local runtime configuration, never in Git.
*.env
.env
*-keys.env
.browser-lab-keys.env
secrets*
*.secret
*.pem
*.key

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp

# Node
node_modules/

# Build artifacts — installation happens over git from the marketplace, so a
# committed .plugin archive is only a copy that goes stale (build with build.sh).
*.plugin

# mitmproxy-mcp scratch database
mitm_mcp_traffic.db

# Python bytecode from design-tools/scripts
__pycache__/
